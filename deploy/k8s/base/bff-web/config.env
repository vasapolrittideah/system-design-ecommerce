# Environment-agnostic configuration for the web BFF.
#
# Every value here is safe in any deployment. Anything that differs between
# local and production is overridden by an overlay's own config.env, and
# anything secret lives in a Secret instead — of which this service has none:
# it holds a public verification key and no credential of its own.
#
# The prefixes are not arbitrary: each one is the prefix a pkg/ config struct
# is loaded under, so a name that does not match a field is silently ignored
# rather than rejected. Check the struct before adding a line.

# pkg/logger — LOG_
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=bff-web

# pkg/observability — OBS_
OBS_SERVICE=bff-web
OBS_TRACING_ENABLED=true
OBS_OTLP_INSECURE=true
# This process starts the traces every other service continues. Sampling is
# parent-based downstream, so this ratio governs the whole system's traces, not
# just this tier's spans.
OBS_SAMPLE_RATIO=0.1
OBS_ADMIN_ADDR=:9090

# pkg/httpx (Server) — BFF_WEB_HTTP_
BFF_WEB_HTTP_ADDR=:8080
BFF_WEB_HTTP_READ_HEADER_TIMEOUT=5s
BFF_WEB_HTTP_READ_TIMEOUT=10s
# The backstop for a handler that ignored its context, deliberately far above
# BFF_WEB_REQUEST_TIMEOUT: this one severs the connection and tells the client
# nothing, where the budget below becomes a readable error body.
BFF_WEB_HTTP_WRITE_TIMEOUT=15s
BFF_WEB_HTTP_IDLE_TIMEOUT=120s
# Must stay under terminationGracePeriodSeconds minus the preStop sleep, or
# the kubelet's SIGKILL lands mid-drain. See deployment.yaml.
BFF_WEB_HTTP_SHUTDOWN_TIMEOUT=25s

# This tier's share of the cascading budget: Kong 5s, here, downstream 300ms.
# The gap between this and the client timeout below is what a fallback or a
# partial response gets to spend after a call has already failed.
BFF_WEB_REQUEST_TIMEOUT=800ms

# pkg/grpcx/client (identity) — BFF_WEB_IDENTITY_
# dns:/// rather than a bare host:port: it resolves every pod behind the
# headless Service and re-resolves as they change, which is what the
# round-robin policy needs to have anything to balance across.
BFF_WEB_IDENTITY_TARGET=dns:///identity:50051
BFF_WEB_IDENTITY_TIMEOUT=300ms
BFF_WEB_IDENTITY_MAX_ATTEMPTS=3
BFF_WEB_IDENTITY_RETRY_BACKOFF=20ms
BFF_WEB_IDENTITY_RETRY_MAX_BACKOFF=200ms
# Must stay above identity's IDENTITY_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or
# the server answers these pings with GOAWAY.
BFF_WEB_IDENTITY_KEEPALIVE_TIME=30s
BFF_WEB_IDENTITY_KEEPALIVE_TIMEOUT=10s

# pkg/grpcx/client (catalog) — BFF_WEB_CATALOG_
# A second block rather than shared settings: what suits a login is not what
# suits a listing, and one target being slow must not retune the other.
BFF_WEB_CATALOG_TARGET=dns:///catalog:50051
BFF_WEB_CATALOG_TIMEOUT=300ms
# Every RPC this BFF makes to catalog is a List, which the client treats as
# idempotent by its name — so these attempts are real ones, not a setting with
# nothing to apply to.
BFF_WEB_CATALOG_MAX_ATTEMPTS=3
BFF_WEB_CATALOG_RETRY_BACKOFF=20ms
BFF_WEB_CATALOG_RETRY_MAX_BACKOFF=200ms
# Must stay above catalog's CATALOG_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or the
# server answers these pings with GOAWAY.
BFF_WEB_CATALOG_KEEPALIVE_TIME=30s
BFF_WEB_CATALOG_KEEPALIVE_TIMEOUT=10s

# pkg/grpcx/client (inventory) — BFF_WEB_INVENTORY_
# Availability is the optional half of the product page, so this block is tuned
# to fail fast rather than to try hard: a warehouse that is slow costs the counts
# on that page, and every millisecond spent retrying is one the rest of the page
# is waiting for.
BFF_WEB_INVENTORY_TARGET=dns:///inventory:50051
BFF_WEB_INVENTORY_TIMEOUT=200ms
# GetStockBySKUs is a read, so the client's method-name rule treats it as
# idempotent and these attempts are real ones.
BFF_WEB_INVENTORY_MAX_ATTEMPTS=2
BFF_WEB_INVENTORY_RETRY_BACKOFF=20ms
BFF_WEB_INVENTORY_RETRY_MAX_BACKOFF=100ms
# Must stay above inventory's INVENTORY_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or
# the server answers these pings with GOAWAY.
BFF_WEB_INVENTORY_KEEPALIVE_TIME=30s
BFF_WEB_INVENTORY_KEEPALIVE_TIMEOUT=10s

# pkg/auth (Verifier) — BFF_WEB_JWT_
# Signer and verifier are different pods on different nodes, and their clocks
# drift. Without leeway a token is briefly not-yet-valid at the moment it is
# issued — a login that fails once and works on retry.
BFF_WEB_JWT_LEEWAY=30s

# pkg/grpcx/client (order) — BFF_WEB_ORDER_
# Checkout fans out again on the far side — catalog for prices, inventory for
# the hold — so this deadline is the widest of the three and still inside the
# BFF's own 800ms budget.
BFF_WEB_ORDER_TARGET=dns:///order:50051
BFF_WEB_ORDER_TIMEOUT=700ms
# Checkout is a mutation, so the client's name-based rule does not retry it
# whatever this says; the reads on the same connection are what these bound.
BFF_WEB_ORDER_MAX_ATTEMPTS=2
BFF_WEB_ORDER_RETRY_BACKOFF=20ms
BFF_WEB_ORDER_RETRY_MAX_BACKOFF=100ms
# Must stay above order's ORDER_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or the
# server answers a well-behaved client's pings with GOAWAY.
BFF_WEB_ORDER_KEEPALIVE_TIME=30s
BFF_WEB_ORDER_KEEPALIVE_TIMEOUT=10s

# pkg/grpcx/client (payment) — BFF_WEB_PAYMENT_
# The tightest deadline in this file relative to what it is waiting for, and
# deliberately so. InitiatePayment reads the order and then calls a payment
# provider on the far side of the internet, which payment gives 5s of its own —
# far past this tier's whole 800ms budget. What this value decides is therefore
# not how long the provider gets, but how long a customer stares at a spinner
# before being told to check the order instead: a provider slower than this
# answers 504 here while the attempt stays pending in payment, which is the
# state it reconciles rather than a state anything is lost in.
BFF_WEB_PAYMENT_TARGET=dns:///payment:50051
BFF_WEB_PAYMENT_TIMEOUT=750ms
# Both calls this BFF makes to payment are mutations — InitiatePayment and
# HandleProviderCallback — so the client's name-based rule retries neither, and
# a number above 1 would be a setting with nothing to apply to. A retried
# payment that was not deduplicated is a second charge.
BFF_WEB_PAYMENT_MAX_ATTEMPTS=1
# Must stay above payment's PAYMENT_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or the
# server answers a well-behaved client's pings with GOAWAY.
BFF_WEB_PAYMENT_KEEPALIVE_TIME=30s
BFF_WEB_PAYMENT_KEEPALIVE_TIMEOUT=10s
