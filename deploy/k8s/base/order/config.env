# Environment-agnostic configuration for the order service.
#
# Every value here is safe in any deployment. Anything that differs between
# local and production is overridden by an overlay's own config.env, and
# anything secret lives in the Secret instead.
#
# The prefixes are not arbitrary: each one is the prefix a pkg/ config struct
# is loaded under, so a name that does not match a field is silently ignored
# rather than rejected. Check the struct before adding a line.

# pkg/logger — LOG_
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=order

# pkg/observability — OBS_
OBS_SERVICE=order
OBS_TRACING_ENABLED=true
OBS_OTLP_INSECURE=true
OBS_SAMPLE_RATIO=0.1
OBS_ADMIN_ADDR=:9090

# pkg/grpcx/server — ORDER_GRPC_
ORDER_GRPC_ADDR=:50051
# Must stay under terminationGracePeriodSeconds minus the preStop sleep, or
# the kubelet's SIGKILL lands mid-drain. See deployment.yaml.
ORDER_GRPC_SHUTDOWN_TIMEOUT=25s
# What forces callers to re-resolve DNS, so a scaled-out replica actually
# receives traffic.
ORDER_GRPC_MAX_CONNECTION_AGE=30m
ORDER_GRPC_MAX_CONNECTION_AGE_GRACE=10s
ORDER_GRPC_KEEPALIVE_TIME=30s
# Must stay below every caller's KEEPALIVE_TIME, or the server answers a
# well-behaved client's pings with GOAWAY.
ORDER_GRPC_MIN_CLIENT_PING_INTERVAL=10s
ORDER_GRPC_REFLECTION=false

# pkg/postgres — ORDER_DB_
ORDER_DB_PORT=5432
ORDER_DB_USER=order
ORDER_DB_DATABASE=order
# Default require, so a misconfigured deployment fails to connect instead of
# sending credentials in the clear. The local overlay opts out explicitly.
ORDER_DB_SSLMODE=require
ORDER_DB_MAX_CONNS=10
ORDER_DB_MIN_CONNS=2

# pkg/grpcx/client (catalog) — ORDER_CATALOG_
# Checkout asks it what the cart costs. Both fan-out deadlines sit inside the
# BFF's 800ms budget with room for the reservation that follows.
ORDER_CATALOG_TARGET=dns:///catalog:50051
ORDER_CATALOG_TIMEOUT=300ms
# A price lookup is a read, so the client's own name-based rule already retries
# it; these bound how hard.
ORDER_CATALOG_MAX_ATTEMPTS=3
ORDER_CATALOG_RETRY_BACKOFF=20ms
ORDER_CATALOG_RETRY_MAX_BACKOFF=200ms
# Must stay above catalog's CATALOG_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or the
# server answers these pings with GOAWAY.
ORDER_CATALOG_KEEPALIVE_TIME=30s
ORDER_CATALOG_KEEPALIVE_TIMEOUT=10s

# pkg/grpcx/client (inventory) — ORDER_INVENTORY_
# ReserveStock is a mutation and is deliberately not retried by the client: the
# far end deduplicates on the order id, but a retry the caller cannot see the
# outcome of is a hold this service may not know it holds.
ORDER_INVENTORY_TARGET=dns:///inventory:50051
ORDER_INVENTORY_TIMEOUT=300ms
ORDER_INVENTORY_MAX_ATTEMPTS=2
ORDER_INVENTORY_RETRY_BACKOFF=20ms
ORDER_INVENTORY_RETRY_MAX_BACKOFF=100ms
# Must stay above inventory's INVENTORY_GRPC_MIN_CLIENT_PING_INTERVAL (10s).
ORDER_INVENTORY_KEEPALIVE_TIME=30s
ORDER_INVENTORY_KEEPALIVE_TIMEOUT=10s
# Unlike ReserveStock above: CommitReservation is idempotent at the far end —
# committing a reservation already committed changes nothing — so cmd/worker's
# retry of it is as safe as a read's.
ORDER_INVENTORY_IDEMPOTENT_METHODS=CommitReservation

# pkg/kafkax (PublisherConfig) — KAFKA_
# Read by cmd/outboxrelay and cmd/worker, the latter using it only to route a
# message it gave up on to the topic's own .dlq.
KAFKA_BROKERS=kafka:9092
KAFKA_WRITE_TIMEOUT=10s
KAFKA_MAX_ATTEMPTS=3

# pkg/outbox (RelayConfig) — OUTBOX_
OUTBOX_BATCH_SIZE=100
# The floor on how stale an event can be, which is also the floor on how long
# after checkout the hold is turned into a sale.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_MAX_BACKOFF=30s
OUTBOX_STATS_INTERVAL=15s

# pkg/kafkax (ConsumerConfig) — KAFKA_CONSUMER_
# Read by cmd/worker alone: this service's own consumer of the topic it
# publishes to, which is what turns a reservation into a sale once the order
# holding it is durably persisted.
KAFKA_CONSUMER_GROUP_ID=order.checkout-saga
KAFKA_CONSUMER_TOPIC=ecommerce.order.events.v1
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_BACKOFF=200ms
