# Environment-agnostic configuration for the inventory service.
#
# Every value here is safe in any deployment. Anything that differs between
# local and production is overridden by an overlay's own config.env, and
# anything secret lives in the Secret instead.
#
# The prefixes are not arbitrary: each one is the prefix a pkg/ config struct
# is loaded under, so a name that does not match a field is silently ignored
# rather than rejected. Check the struct before adding a line.
#
# Both binaries read this same ConfigMap. The server ignores INVENTORY_REAPER_*
# and the reaper ignores INVENTORY_GRPC_*, which is cheaper than two files that
# have to agree about the database.

# pkg/logger — LOG_
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=inventory

# pkg/observability — OBS_
OBS_SERVICE=inventory
OBS_TRACING_ENABLED=true
OBS_OTLP_INSECURE=true
# Only governs traces this process starts itself. The server starts none — every
# call arrives with a decision bff-web already made — but the reaper does: its
# sweeps have no caller and are therefore the root of their own trace.
OBS_SAMPLE_RATIO=0.1
OBS_ADMIN_ADDR=:9090

# pkg/grpcx/server — INVENTORY_GRPC_
INVENTORY_GRPC_ADDR=:50051
# Must stay under terminationGracePeriodSeconds minus the preStop sleep, or
# the kubelet's SIGKILL lands mid-drain. See deployment.yaml.
INVENTORY_GRPC_SHUTDOWN_TIMEOUT=25s
# What forces callers to re-resolve DNS, so a scaled-out replica actually
# receives traffic. Client-side balancing only spreads across the replicas
# that existed when the caller last resolved.
INVENTORY_GRPC_MAX_CONNECTION_AGE=30m
INVENTORY_GRPC_MAX_CONNECTION_AGE_GRACE=10s
INVENTORY_GRPC_KEEPALIVE_TIME=30s
# Must stay below every caller's KEEPALIVE_TIME, or the server answers a
# well-behaved client's pings with GOAWAY.
INVENTORY_GRPC_MIN_CLIENT_PING_INTERVAL=10s
INVENTORY_GRPC_REFLECTION=false

# How long a hold survives — INVENTORY_RESERVATION_
#
# It has to exceed the longest a checkout can legitimately take, because a hold
# that expires under a shopper who is still paying becomes a refund; and it has
# to be short enough that an abandoned basket does not keep a popular SKU off
# the shelf for an afternoon. Fifteen minutes is a payment redirect plus room.
INVENTORY_RESERVATION_TTL=15m

# The sweep — INVENTORY_REAPER_
#
# INTERVAL is the worst case for how long a stranded hold keeps capacity off the
# shelf, on top of the TTL itself. BATCH_SIZE bounds one transaction, and every
# reservation in it holds row locks on SKUs nobody else can reserve meanwhile —
# so raising it trades sweep throughput against how long a popular SKU can be
# blocked by a sweep.
INVENTORY_REAPER_INTERVAL=30s
INVENTORY_REAPER_BATCH_SIZE=100
INVENTORY_REAPER_MAX_BACKOFF=5m

# pkg/postgres — INVENTORY_DB_
INVENTORY_DB_PORT=5432
INVENTORY_DB_USER=inventory
INVENTORY_DB_DATABASE=inventory
# Default require, so a misconfigured deployment fails to connect instead of
# sending credentials in the clear. The local overlay opts out explicitly.
INVENTORY_DB_SSLMODE=require
# Every reservation is one statement per line plus two more, and they all
# contend on the same rows — a pool that queues here queues checkout.
INVENTORY_DB_MAX_CONNS=15
INVENTORY_DB_MIN_CONNS=2
