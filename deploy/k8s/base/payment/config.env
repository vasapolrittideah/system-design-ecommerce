# Environment-agnostic configuration for the payment service.
#
# Every value here is safe in any deployment. Anything that differs between
# local and production is overridden by an overlay's own config.env, and
# anything secret lives in the Secret instead.
#
# The prefixes are not arbitrary: each one is the prefix a pkg/ config struct
# is loaded under, so a name that does not match a field is silently ignored
# rather than rejected. Check the struct before adding a line.

# pkg/logger — LOG_
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=payment

# pkg/observability — OBS_
OBS_SERVICE=payment
OBS_TRACING_ENABLED=true
OBS_OTLP_INSECURE=true
OBS_SAMPLE_RATIO=0.1
OBS_ADMIN_ADDR=:9090

# pkg/grpcx/server — PAYMENT_GRPC_
PAYMENT_GRPC_ADDR=:50051
# Must stay under terminationGracePeriodSeconds minus the preStop sleep, or
# the kubelet's SIGKILL lands mid-drain. See deployment.yaml.
PAYMENT_GRPC_SHUTDOWN_TIMEOUT=25s
# What forces callers to re-resolve DNS, so a scaled-out replica actually
# receives traffic.
PAYMENT_GRPC_MAX_CONNECTION_AGE=30m
PAYMENT_GRPC_MAX_CONNECTION_AGE_GRACE=10s
PAYMENT_GRPC_KEEPALIVE_TIME=30s
# Must stay below every caller's KEEPALIVE_TIME, or the server answers a
# well-behaved client's pings with GOAWAY.
PAYMENT_GRPC_MIN_CLIENT_PING_INTERVAL=10s
PAYMENT_GRPC_REFLECTION=false

# pkg/postgres — PAYMENT_DB_
PAYMENT_DB_PORT=5432
PAYMENT_DB_USER=payment
PAYMENT_DB_DATABASE=payment
# Default require, so a misconfigured deployment fails to connect instead of
# sending credentials in the clear. The local overlay opts out explicitly.
PAYMENT_DB_SSLMODE=require
PAYMENT_DB_MAX_CONNS=10
PAYMENT_DB_MIN_CONNS=2

# pkg/grpcx/client (order) — PAYMENT_ORDER_
# Read synchronously before an attempt is written, to learn what the order
# costs and whether it may still be paid for. On the critical path of somebody
# pressing Pay, so it sits inside the BFF's 800ms budget with room left for the
# provider call that follows.
PAYMENT_ORDER_TARGET=dns:///order:50051
PAYMENT_ORDER_TIMEOUT=300ms
# GetOrder is a read, so the client's own name-based rule already retries it;
# these bound how hard.
PAYMENT_ORDER_MAX_ATTEMPTS=3
PAYMENT_ORDER_RETRY_BACKOFF=20ms
PAYMENT_ORDER_RETRY_MAX_BACKOFF=200ms
# Must stay above order's ORDER_GRPC_MIN_CLIENT_PING_INTERVAL (10s), or the
# server answers these pings with GOAWAY.
PAYMENT_ORDER_KEEPALIVE_TIME=30s
PAYMENT_ORDER_KEEPALIVE_TIMEOUT=10s

# services/payment/internal/adapter/out/provider — PAYMENT_PROVIDER_
# The one dependency that is not another service in this cluster. No BASE_URL
# here and no SECRET: which provider this is, is the whole of what differs
# between deployments, and the secret is in the Secret. An overlay that names
# neither leaves the process failing to start, which is the right failure —
# a payment service that came up pointing at nothing would accept requests it
# could never fulfil.
#
# Deliberately the longest timeout of the three. A card network is slower than
# anything east-west, and cutting it short turns an answer into an ambiguous
# timeout this service then has to reconcile against the provider.
PAYMENT_PROVIDER_TIMEOUT=5s

# pkg/kafkax (PublisherConfig) — KAFKA_
# Read by cmd/outboxrelay alone. This service consumes nothing: it publishes
# what happened and the order service decides what that means for an order.
KAFKA_BROKERS=kafka:9092
KAFKA_WRITE_TIMEOUT=10s
KAFKA_MAX_ATTEMPTS=3

# pkg/outbox (RelayConfig) — OUTBOX_
OUTBOX_BATCH_SIZE=100
# The floor on how stale an event can be, which is also the floor on how long
# after the money arrives the order learns about it.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_MAX_BACKOFF=30s
OUTBOX_STATS_INTERVAL=15s
