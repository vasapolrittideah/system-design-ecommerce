# Environment-agnostic configuration for the identity service.
#
# Every value here is safe in any deployment. Anything that differs between
# local and production is overridden by an overlay's own config.env, and
# anything secret lives in the Secret instead.
#
# The prefixes are not arbitrary: each one is the prefix a pkg/ config struct
# is loaded under, so a name that does not match a field is silently ignored
# rather than rejected. Check the struct before adding a line.

# pkg/logger — LOG_
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=identity

# pkg/observability — OBS_
OBS_SERVICE=identity
OBS_TRACING_ENABLED=true
OBS_OTLP_INSECURE=true
OBS_SAMPLE_RATIO=0.1
OBS_ADMIN_ADDR=:9090

# pkg/grpcx/server — IDENTITY_GRPC_
IDENTITY_GRPC_ADDR=:50051
# Must stay under terminationGracePeriodSeconds minus the preStop sleep, or
# the kubelet's SIGKILL lands mid-drain. See deployment.yaml.
IDENTITY_GRPC_SHUTDOWN_TIMEOUT=25s
# What forces callers to re-resolve DNS, so a scaled-out replica actually
# receives traffic. Client-side balancing only spreads across the replicas
# that existed when the caller last resolved.
IDENTITY_GRPC_MAX_CONNECTION_AGE=30m
IDENTITY_GRPC_MAX_CONNECTION_AGE_GRACE=10s
IDENTITY_GRPC_KEEPALIVE_TIME=30s
# Must stay below every caller's KEEPALIVE_TIME, or the server answers a
# well-behaved client's pings with GOAWAY.
IDENTITY_GRPC_MIN_CLIENT_PING_INTERVAL=10s
IDENTITY_GRPC_REFLECTION=false

# pkg/postgres — IDENTITY_DB_
IDENTITY_DB_PORT=5432
IDENTITY_DB_USER=identity
IDENTITY_DB_DATABASE=identity
# Default require, so a misconfigured deployment fails to connect instead of
# sending credentials in the clear. The local overlay opts out explicitly.
IDENTITY_DB_SSLMODE=require
IDENTITY_DB_MAX_CONNS=10
IDENTITY_DB_MIN_CONNS=2

# pkg/auth (Signer) — IDENTITY_JWT_
# Stamped on every token as "kid" from the first one. Rotating a key means
# running two while old tokens drain, and a verifier can only pick between
# them if the token says which signed it.
IDENTITY_JWT_KEY_ID=identity-k1
IDENTITY_JWT_TTL=15m

# pkg/kafkax (PublisherConfig) — KAFKA_
# Read by cmd/outboxrelay alone; the server never publishes. The broker is
# headless, so this name resolves to the pod and the metadata it answers with
# names the pod too.
KAFKA_BROKERS=kafka:9092
KAFKA_WRITE_TIMEOUT=10s
# Small on purpose: the relay retries the whole cycle with backoff and the rows
# stay in the table until it succeeds, so nothing is lost by failing early and
# everything is delayed by failing slowly.
KAFKA_MAX_ATTEMPTS=3

# pkg/outbox (RelayConfig) — OUTBOX_
OUTBOX_BATCH_SIZE=100
# The floor on how stale an event can be, which is also why a caller is told
# its work is done before the event has left.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_MAX_BACKOFF=30s
OUTBOX_STATS_INTERVAL=15s

# services/identity/internal/app (SessionConfig) — IDENTITY_SESSION_
# The whole rotation chain's life, not one link's: refreshing does not extend
# it, so this is also the longest a session survives without the user proving
# who they are again.
IDENTITY_SESSION_REFRESH_TTL=720h
