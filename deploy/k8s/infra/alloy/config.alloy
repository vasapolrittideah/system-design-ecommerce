// What puts stdout into Loki. Nothing in this repo ships its own logs: every
// process writes zap JSON to stdout, the kubelet writes that to a file on the
// node, and this tails the file. That indirection is the point — a process that
// pushed to Loki itself would buffer logs in its own heap and lose them in a
// crash, which is the one moment the logs matter.

// One Alloy per node tailing only that node's pods, which is what the field
// selector is for: without it every replica discovers every pod in the
// namespace and then looks for log files that are on a different machine.
discovery.kubernetes "pods" {
	role = "pod"

	namespaces {
		own_namespace = true
	}

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

// The labels a log stream is stored under. Deliberately few: every distinct
// combination is a separate stream and a separate index entry in Loki, so a
// label with an unbounded range of values — a trace ID, a user ID, a request
// path — is how a log backend runs out of memory. Anything else worth querying
// is inside the JSON line and reachable with `| json` at query time.
//
// `service` is the same label Prometheus puts on every series and the same
// resource attribute on every span. One name across the three signals is what
// lets a dashboard move between them.
discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	// Where the kubelet writes it: /var/log/pods/<ns>_<pod>_<uid>/<container>/*.log
	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}
}

// The glob in __path__ above is expanded here and nowhere else:
// loki.source.file opens the literal path it is given, so handing it a pattern
// makes every target fail to stat with the pattern printed back as a filename.
// This is also what notices a new container's file appearing.
local.file_match "pods" {
	path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
	targets    = local.file_match.pods.targets
	forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
	forward_to = [loki.write.default.receiver]

	// The kubelet's line, not the container's: every line on disk is prefixed
	// with a timestamp, the stream, and a partial-line flag. Without this stage
	// the JSON never parses because it does not start at column one, and the
	// timestamp Loki stores is the moment Alloy read the file rather than the
	// moment the line was written.
	stage.cri {}

	// Only the Go services write JSON; Kong and Postgres write prose, and a json
	// stage applied to a line that is not JSON fails once per line. Matching on
	// the shape of the line rather than on a list of service names means a new
	// service is covered for using pkg/logger, not for being added here.
	//
	// The local overlays set LOG_FORMAT=console, so on a laptop this matches
	// nothing and every line is stored as zap printed it. That is the same
	// pipeline a deployed environment runs, not a local variant of it — which
	// is the point: `| json` works in Explore wherever the format is json, and
	// the trace ID is extractable either way, because zap's console encoder
	// still prints the fields as a JSON object.
	stage.match {
		selector = "{service=~\".+\"} |~ \"^\\\\{\""

		stage.json {
			expressions = {
				level = "level",
			}
		}

		// The one field promoted to a label. It has five values, and it is what
		// splits the volume histogram in Explore into a line worth looking at.
		// Lines that skip this stage are not left without one: Loki 3 attaches a
		// `detected_level` of its own, which is why a console-formatted pod is
		// still filterable by level.
		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// loki.source.file adds `filename`, the full path including the pod UID.
	// That is a new stream on every restart, carrying nothing `pod` and
	// `container` do not already say.
	stage.label_drop {
		values = ["filename"]
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
