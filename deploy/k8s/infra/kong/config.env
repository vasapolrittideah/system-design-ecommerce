# The gateway's per-cluster values, read by the init container that renders
# kong.yml — never by Kong itself, which is why nothing here carries the KONG_
# prefix Kong reserves for its own settings and warns about when it does not
# recognise one.
#
# Everything else about the gateway is the same everywhere and lives in
# kong.yml as a literal. A value earns a line here only when naming one value
# for every cluster would be wrong rather than merely inconvenient — the list
# is meant to stay short, because a gateway config assembled from a template
# and an env file is one nobody can read in a diff.

# The browser origins allowed to call this API, as a YAML flow sequence:
#
#	CORS_ORIGINS=["https://vasapol.dev","https://www.vasapol.dev"]
#
# Deliberately empty here. An origin names a deployment, so base has no honest
# value to hold, and the init container fails loudly on the empty one rather
# than rendering a gateway that allows nothing — or worse, inheriting a
# laptop's origin into the cluster that faces the internet.
CORS_ORIGINS=
