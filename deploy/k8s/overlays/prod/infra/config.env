# The gateway's per-cluster values on the cluster that actually serves.

# The storefront, and only the storefront. api.vasapol.dev is deliberately not
# here: an origin is where the page making the request came from, never the API
# it is calling, and adding the API's own hostname to this list allows nothing
# that was not already allowed while reading as though it does.
#
# Kong's cors plugin has credentials: false, so nothing here needs to be a
# wildcard and none of these may become one — the day a refresh token moves
# into an httpOnly cookie, credentials becomes true and a wildcard stops being
# legal at all.
CORS_ORIGINS=["https://vasapol.dev","https://www.vasapol.dev"]
