# Production-only overrides, merged over base/catalog/config.env.
#
# Almost the same as staging's, and that similarity is the useful part: staging
# is what proves base can be deployed without laptop relaxations, so this file
# inherits that proof rather than re-establishing it.

# Jaeger all-in-one from deploy/k8s/infra.
OBS_OTLP_ENDPOINT=jaeger:4317

CATALOG_DB_HOST=catalog-postgres
# The instance in components/catalog-postgres speaks plaintext, and it is
# reachable only from pods labelled catalog — the NetworkPolicy beside it is
# what enforces that, not this line. Delete this the day the database moves out
# of the cluster.
CATALOG_DB_SSLMODE=disable
