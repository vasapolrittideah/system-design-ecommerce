# Production-only overrides, merged over base/bff-web/config.env.

# Jaeger all-in-one from deploy/k8s/infra.
OBS_OTLP_ENDPOINT=jaeger:4317

# Must match what identity's overlay signs with, exactly. A mismatch rejects
# every token with TOKEN_INVALID while every pod stays Ready and nothing else
# reports why — which is the failure `make smoke` reaches /api/v1/me to catch.
BFF_WEB_JWT_ISSUER=https://identity.prod
BFF_WEB_JWT_AUDIENCE=ecommerce-prod
