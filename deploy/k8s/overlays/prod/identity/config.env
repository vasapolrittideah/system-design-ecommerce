# Production-only overrides, merged over base/identity/config.env.
#
# Almost the same as staging's, and that similarity is the useful part: staging
# is what proves base can be deployed without laptop relaxations, so this file
# inherits that proof rather than re-establishing it.

# Jaeger all-in-one from deploy/k8s/infra.
OBS_OTLP_ENDPOINT=jaeger:4317

IDENTITY_DB_HOST=identity-postgres
# The instance in components/identity-postgres speaks plaintext, and it is
# reachable only from pods labelled identity — the NetworkPolicy beside it is
# what enforces that, not this line. Delete this the day the database moves out
# of the cluster.
IDENTITY_DB_SSLMODE=disable

# iss and aud name this deployment, and deliberately not the public domain the
# gateway answers on. They are checked by the verifier rather than resolved, so
# tying them to a hostname would mean that moving the site to another domain
# invalidated every token already in a browser. What they have to be is unique
# per deployment: identical values here and in staging would make one
# environment's token open the other's session wherever a key pair got shared.
IDENTITY_JWT_ISSUER=https://identity.prod
IDENTITY_JWT_AUDIENCE=ecommerce-prod
