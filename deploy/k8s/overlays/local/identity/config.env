# Local-only overrides, merged over base/identity/config.env.
#
# Anything that is the same everywhere belongs in base. A line here is a claim
# that local genuinely differs — which is also why there is no `if env ==
# "local"` anywhere in the Go code.

# Colours and aligned columns beat parseability on a laptop.
LOG_FORMAT=console
LOG_LEVEL=debug

# Jaeger all-in-one from deploy/k8s/infra.
OBS_OTLP_ENDPOINT=jaeger:4317
# Every trace, because on a laptop there are about nine of them and missing
# the one you are debugging costs more than the storage.
OBS_SAMPLE_RATIO=1.0

# grpcurl and grpcui need it; production does not, and it publishes the whole
# API surface to anything that can reach the port.
IDENTITY_GRPC_REFLECTION=true

IDENTITY_DB_HOST=identity-postgres
# Explicit opt-out. The default is require precisely so that this has to be a
# deliberate line in a file someone can find.
IDENTITY_DB_SSLMODE=disable
IDENTITY_DB_MAX_CONNS=5

# iss and aud are checked by the verifier, not merely read, so they name the
# deployment rather than the service — a token minted here must not open a
# session anywhere else that happens to share a key pair.
IDENTITY_JWT_ISSUER=http://identity.local
IDENTITY_JWT_AUDIENCE=ecommerce-local
