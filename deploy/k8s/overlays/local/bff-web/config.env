# Local-only overrides, merged over base/bff-web/config.env.
#
# Anything that is the same everywhere belongs in base. A line here is a claim
# that local genuinely differs — which is also why there is no `if env ==
# "local"` anywhere in the Go code.

# Colours and aligned columns beat parseability on a laptop.
LOG_FORMAT=console
LOG_LEVEL=debug

# Jaeger all-in-one from deploy/k8s/infra.
OBS_OTLP_ENDPOINT=jaeger:4317
# Every trace, because on a laptop there are about nine of them and missing
# the one you are debugging costs more than the storage. This process is where
# traces begin, so it is the ratio that decides how many exist at all.
OBS_SAMPLE_RATIO=1.0

# Checked by the verifier, not merely read, and they must match what identity's
# overlay signs with exactly — a mismatch here rejects every token with
# TOKEN_INVALID and nothing else reports it.
BFF_WEB_JWT_ISSUER=http://identity.local
BFF_WEB_JWT_AUDIENCE=ecommerce-local
