# Local-only overrides, merged over base/payment/config.env.
#
# Anything that is the same everywhere belongs in base. A line here is a claim
# that local genuinely differs — which is also why there is no `if env ==
# "local"` anywhere in the Go code.

# Colours and aligned columns beat parseability on a laptop.
LOG_FORMAT=console
LOG_LEVEL=debug

# Jaeger all-in-one from deploy/k8s/infra.
OBS_OTLP_ENDPOINT=jaeger:4317
# Every trace, because on a laptop there are about nine of them and missing
# the one you are debugging costs more than the storage.
OBS_SAMPLE_RATIO=1.0

# grpcurl and grpcui need it; production does not, and it publishes the whole
# API surface to anything that can reach the port.
PAYMENT_GRPC_REFLECTION=true

PAYMENT_DB_HOST=payment-postgres
# Explicit opt-out. The default is require precisely so that this has to be a
# deliberate line in a file someone can find.
PAYMENT_DB_SSLMODE=disable
PAYMENT_DB_MAX_CONNS=5

# Shorter deadlines than production would want, because everything is one hop
# away on a loopback and a slow answer here is a bug rather than a network.
PAYMENT_ORDER_TIMEOUT=1s

# The stand-in provider this overlay also deploys. This one line is the whole
# of what makes local's provider a fake: pointing it at a real one is a value
# rather than a branch, which is why nothing in the Go knows which it is
# talking to.
PAYMENT_PROVIDER_BASE_URL=http://payment-fakeprovider:8080
# Longer than base's 5s, because behaviour 05 exists to hang and a laptop
# waiting the default out is the test taking longer, not failing sooner.
PAYMENT_PROVIDER_TIMEOUT=10s

# Read by the fake provider alone, out of the same ConfigMap. Its signing
# secret is deliberately not on this list: it is PAYMENT_PROVIDER_SECRET in the
# Secret, one variable read by both sides, because two names for one value is
# how a webhook stops verifying after somebody rotates half of it.
FAKEPROVIDER_ADDR=:8080
# Where it posts webhooks: the BFF's callback endpoint, which is the path a
# real provider would take. Reaching payment directly would exercise a route no
# provider can use and would skip the forwarding hop entirely.
FAKEPROVIDER_CALLBACK_URL=http://bff-web:8080/api/v1/webhooks/payment
# Short enough that clicking through the storefront does not feel broken.
FAKEPROVIDER_WEBHOOK_DELAY=2s
FAKEPROVIDER_SHUTDOWN_TIMEOUT=15s
