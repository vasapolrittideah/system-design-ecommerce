# Staging-only overrides, merged over base/inventory/config.env.
#
# Deliberately short. Every line the local overlay sets and this one does not is
# a laptop relaxation rather than a setting — console logs, gRPC reflection, and
# a reservation that expires in two minutes so a hold can be watched dying
# without leaving for lunch. Base's fifteen is the number a payment redirect
# needs, and it applies here because nothing overrides it. What is left below is
# what genuinely differs between one deployment and another.

# Jaeger all-in-one from deploy/k8s/infra. It matches local's value because both
# run that same Jaeger; a deployment with a collector of its own changes this
# line and nothing else.
OBS_OTLP_ENDPOINT=jaeger:4317

INVENTORY_DB_HOST=inventory-postgres
# The instance in components/inventory-postgres speaks plaintext, so the opt-out
# is still explicit. This is the first line to delete on the day the database
# moves out of the cluster.
INVENTORY_DB_SSLMODE=disable
