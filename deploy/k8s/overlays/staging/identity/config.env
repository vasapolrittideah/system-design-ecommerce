# Staging-only overrides, merged over base/identity/config.env.
#
# Almost exactly prod's, and the similarity is the whole point of this file: an
# environment that differs from prod in its settings proves nothing about prod.
# What differs below is what names the deployment, and nothing else.

# Jaeger all-in-one from deploy/k8s/infra, in this namespace. Staging runs its
# own — the Service name resolves inside ecommerce-staging, so this line is
# identical to prod's and still points somewhere else.
OBS_OTLP_ENDPOINT=jaeger:4317

IDENTITY_DB_HOST=identity-postgres
# The instance in components/identity-postgres speaks plaintext, and it is
# reachable only from pods labelled identity — the NetworkPolicy beside it is what
# enforces that, not this line. Delete this the day the database moves out of
# the cluster.
IDENTITY_DB_SSLMODE=disable

# iss and aud are checked by the verifier, not merely read, and they name the
# deployment rather than the service for exactly this reason: staging and prod
# share a k3s host and are told apart by a namespace, so a staging token that
# prod's verifier accepted would be a boundary held by nothing but routing.
# These two lines are what make that impossible even with a key pair leaked
# from one to the other.
IDENTITY_JWT_ISSUER=https://identity.staging
IDENTITY_JWT_AUDIENCE=ecommerce-staging
