# Staging-only overrides, merged over base/bff-web/config.env.
#
# Almost exactly prod's, and the similarity is the whole point of this file: an
# environment that differs from prod in its settings proves nothing about prod.
#
# Note what is *not* here, because it is what a staging environment is usually
# quietly given: no console logging, no debug level, and no OBS_SAMPLE_RATIO of
# 1.0. This process is where a trace begins, so that ratio decides how many
# traces the whole system has — and a staging that samples everything is not
# the system prod runs when a load test says the p99 is fine.

# Jaeger all-in-one from deploy/k8s/infra, in this namespace.
OBS_OTLP_ENDPOINT=jaeger:4317

# Must match what identity's overlay signs with, exactly. A mismatch rejects
# every token with TOKEN_INVALID while every pod stays Ready and nothing else
# reports why — which is the failure `make smoke` reaches /api/v1/me to catch.
BFF_WEB_JWT_ISSUER=https://identity.staging
BFF_WEB_JWT_AUDIENCE=ecommerce-staging
