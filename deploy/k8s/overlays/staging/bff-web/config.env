# Staging-only overrides, merged over base/bff-web/config.env.
#
# Deliberately short. Every line the local overlay sets and this one does not is
# a laptop relaxation rather than a setting — console logs, debug level, and a
# sample ratio of 1.0 — and a second overlay is what makes that distinction
# visible instead of a claim in a comment.

# Jaeger all-in-one from deploy/k8s/infra. It matches local's value because both
# run that same Jaeger; a deployment with a collector of its own changes this
# line and nothing else.
OBS_OTLP_ENDPOINT=jaeger:4317

# Must match what identity's overlay signs with, exactly. A mismatch rejects
# every token with TOKEN_INVALID while every pod stays Ready and nothing else
# reports why — which is the failure `make smoke` reaches /api/v1/me to catch.
BFF_WEB_JWT_ISSUER=http://identity.staging
BFF_WEB_JWT_AUDIENCE=ecommerce-staging
