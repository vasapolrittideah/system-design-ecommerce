# The gateway's per-cluster values on the environment that stands in front of
# prod.

# The staging storefront, and only the storefront. staging-api.vasapol.dev is
# deliberately not here for the same reason prod omits its own API hostname: an
# origin is where the page making the request came from, never the API it is
# calling.
#
# Prod's origins are absent too, and that is the point of this list being a
# per-cluster value at all. A browser on the production storefront must not be
# able to call staging's API — CORS is the only thing standing between the two,
# since they answer on the same edge with the same shape.
CORS_ORIGINS=["https://staging.vasapol.dev"]
