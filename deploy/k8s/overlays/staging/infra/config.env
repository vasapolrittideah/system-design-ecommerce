# The gateway's per-cluster values in CI.

# There is no browser here and no storefront to serve, so this names the same
# origin the laptop does rather than inventing one. What it is here to prove is
# that the value arrives at all — an overlay that set nothing would leave Kong
# refusing to start, which is exactly the failure this mechanism is designed to
# produce and exactly the one CI should catch before prod does.
CORS_ORIGINS=["http://localhost:3000"]
