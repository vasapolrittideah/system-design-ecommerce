# Staging-only overrides, merged over base/catalog/config.env.
#
# Almost exactly prod's, and the similarity is the whole point of this file: an
# environment that differs from prod in its settings proves nothing about prod.
# What differs below is what names the deployment, and nothing else.

# Jaeger all-in-one from deploy/k8s/infra, in this namespace. Staging runs its
# own — the Service name resolves inside ecommerce-staging, so this line is
# identical to prod's and still points somewhere else.
OBS_OTLP_ENDPOINT=jaeger:4317

CATALOG_DB_HOST=catalog-postgres
# The instance in components/catalog-postgres speaks plaintext, and it is
# reachable only from pods labelled catalog — the NetworkPolicy beside it is what
# enforces that, not this line. Delete this the day the database moves out of
# the cluster.
CATALOG_DB_SSLMODE=disable
