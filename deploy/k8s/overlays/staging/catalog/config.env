# Staging-only overrides, merged over base/catalog/config.env.
#
# Deliberately short. Every line the local overlay sets and this one does not is
# a laptop relaxation rather than a setting — console logs, debug level, gRPC
# reflection, a five-connection pool — and a second overlay is what makes that
# distinction visible instead of a claim in a comment. What is left here is what
# genuinely differs between one deployment and another.

# Jaeger all-in-one from deploy/k8s/infra. It matches local's value because both
# run that same Jaeger; a deployment with a collector of its own changes this
# line and nothing else.
OBS_OTLP_ENDPOINT=jaeger:4317

CATALOG_DB_HOST=catalog-postgres
# The instance in components/catalog-postgres speaks plaintext, so the opt-out
# is still explicit. This is the first line to delete on the day the database
# moves out of the cluster.
CATALOG_DB_SSLMODE=disable
