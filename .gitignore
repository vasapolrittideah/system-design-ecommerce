# Local tool installs (make tools) and built service binaries (make build)
/bin/

# Test and coverage output
coverage.out
coverage.html
*.test
*.out

# Local environment — secrets never belong in the repo
.env
.env.*
!.env.example

# Dev signing keys generated by `make keys`. The private key mints any user's
# identity, so it is created per machine and never shared, not even for local.
*.pem

# Database passwords generated by `make seal`. The sealed copy beside them is
# what gets committed; this is the readable original, kept only so that a
# controller reinstalled with a new key means re-sealing rather than rotating
# every credential.
db-password


# Editors / OS
.DS_Store
.idea/
.vscode/

# Claude Code local overrides (settings.json stays tracked)
.claude/settings.local.json
